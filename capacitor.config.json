      "twitter.com",
      "*.twitter.com",
      "api.twitter.com",
      "verify.walletconnect.com",
      "verify.walletconnect.org"
    ]
  },
  "android": {
    "appendUserAgent": "UXGPTApp/1.0",
    "backgroundColor": "#050505",
